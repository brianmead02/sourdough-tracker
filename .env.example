# Copy to .env and adjust. Every value below has a working default for local dev.

# --- app ---------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8000"]
# Used to build links in transactional email.
PUBLIC_BASE_URL=http://localhost:8000

# --- auth --------------------------------------------------------------------
# REQUIRED in prod — the app refuses to start with this default when ENVIRONMENT=prod.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-change-me-before-deploying
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_MIN_LENGTH=10
RATE_LIMIT_ENABLED=true

# argon2id cost. The defaults target roughly 50ms per hash on modern hardware.
# Raising memory_cost is the most effective hardening; lowering these makes
# every login and registration cheaper for an attacker too.
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536    # KiB
# ARGON2_PARALLELISM=4

# --- postgres ----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sourdough
POSTGRES_PASSWORD=sourdough
POSTGRES_DB=sourdough

# --- redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- minio / s3 --------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sourdough-media
MINIO_SECURE=false
# REQUIRED in any real deployment: presigned upload/download URLs are handed to
# browsers and phones, which cannot resolve the compose-internal "minio" host.
# Leave blank only for local work driven from inside the compose network.
MINIO_PUBLIC_ENDPOINT=
MINIO_REGION=us-east-1

# --- media uploads -----------------------------------------------------------
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# --- smtp (mailhog in dev; a real relay in prod) ------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sourdough Tracker <no-reply@sourdough.local>

# --- ntfy --------------------------------------------------------------------
NTFY_BASE_URL=http://ntfy:80
NTFY_PUBLIC_URL=http://localhost:8081

# --- edge (prod profile) -----------------------------------------------------
SITE_ADDRESS=localhost

# --- dev host ports ----------------------------------------------------------
# Only used by docker-compose.dev.yml. Change any that collide with services
# you already run locally; nothing inside the stack depends on these.
API_DEV_PORT=8000
POSTGRES_DEV_PORT=5432
REDIS_DEV_PORT=6379
MINIO_DEV_PORT=9000
MINIO_CONSOLE_DEV_PORT=9001
NTFY_DEV_PORT=8081
MAILHOG_SMTP_DEV_PORT=1025
MAILHOG_UI_DEV_PORT=8025

# --- fermentation model ------------------------------------------------------
# Tuning knobs, not constants: the model is wrong until calibrated against real
# observed-vs-predicted data. Defaults shown; override any of them here.
# FERMENT_REF_TEMP_C=24.0
# FERMENT_BASE_RISE_PER_HOUR=0.15     # 75% rise in 5h at reference conditions
# FERMENT_Q10_WARM=2.0                # rate multiplier per +10C above the threshold
# FERMENT_Q10_COLD=3.0                # steeper below it, so retard is not under-predicted
# FERMENT_COLD_THRESHOLD_C=15.0
# FERMENT_REF_STARTER_PCT=20.0
# FERMENT_INOCULATION_EXPONENT=0.7    # sub-linear: 2x starter is not 2x speed
# FERMENT_REF_PEAK_HOURS=6.0          # a reference starter's time to peak
# FERMENT_VIGOUR_MIN=0.5
# FERMENT_VIGOUR_MAX=2.0
# FERMENT_BASE_SPREAD=0.35            # prediction window half-width, before any checks
# FERMENT_MIN_SPREAD=0.08

# --- notifications -----------------------------------------------------------
# Web Push. Generate a pair with `docker compose exec api sdt vapid-keys`.
# Leave blank and the Web Push channel is simply unavailable — the API reports
# `available: false` and refuses subscriptions rather than failing later.
# The public key is handed to browsers; the private key is a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example

# Reminder delivery tuning. Defaults shown; override only if you have a reason.
# NOTIFICATION_BATCH_SIZE=100          # rows one beat tick claims
# NOTIFICATION_MAX_ATTEMPTS=4          # before a reminder is marked failed
# NOTIFICATION_RETRY_BASE_SECONDS=60   # doubles each attempt: 1, 2, 4 minutes
# NOTIFICATION_STALE_AFTER_HOURS=12    # ceiling on per-event expiry

# ntfy publishing. The shipped default lets anyone publish to a topic, which is
# ntfy's own model — topics are random and act as the password. Set `deny-all`
# and issue per-user tokens if you want stricter control.
# NTFY_DEFAULT_ACCESS=read-write

# --- rarely changed ----------------------------------------------------------
# APP_NAME=Sourdough Tracker
# JWT_ALGORITHM=HS256
