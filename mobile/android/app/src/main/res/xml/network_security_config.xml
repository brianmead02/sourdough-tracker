<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks cleartext HTTP from API 28 onward, which is the right default.

  A development build needs to reach an API running on a laptop over plain HTTP,
  so cleartext is permitted for local addresses only:
    10.0.2.2   the host machine, as seen from the Android emulator
    localhost  an adb-reversed port
    10.0.3.2   the same thing under Genymotion

  Everything else — including any real deployment — must be HTTPS. Widening this
  to `cleartextTrafficPermitted="true"` at the base would send bearer tokens
  over plain HTTP on any network the phone happens to be on.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
